{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BOBC Universal - Estado PWA v1.0 (schema 2)",
  "type": "object",
  "required": [
    "schema",
    "settings",
    "products",
    "recipes",
    "skus",
    "quotes",
    "invoices",
    "payments",
    "documents",
    "movements",
    "manufacturingSpecs",
    "materials",
    "materialMovements",
    "productionOrders"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "migrationVersion": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "company_name": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "productionMethod": {
            "enum": [
              "batch",
              "unit",
              "sheet",
              "custom"
            ]
          }
        }
      }
    },
    "skus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "productId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "sizeMl": {
            "type": "number"
          },
          "outputQty": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "outputUnit": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer"
          }
        }
      }
    },
    "manufacturingSpecs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "productId",
          "method",
          "outputQty",
          "outputUnit",
          "materials"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "legacyRecipeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "integer"
          },
          "method": {
            "enum": [
              "batch",
              "unit",
              "sheet",
              "custom"
            ]
          },
          "outputQty": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "outputUnit": {
            "type": "string"
          },
          "wastePercent": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 100
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "quantity",
                "unit"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "materialId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string"
                },
                "lineCostCents": {
                  "type": "integer"
                },
                "packQuantity": {
                  "type": "number"
                },
                "packPriceCents": {
                  "type": "integer"
                }
              }
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "minutes": {
                  "type": "number"
                },
                "rateCentsPerHour": {
                  "type": "integer"
                }
              }
            }
          },
          "setupCostCents": {
            "type": "integer"
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "packQuantity": {
            "type": "number"
          },
          "packPriceCents": {
            "type": "integer"
          }
        }
      }
    },
    "materialMovements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "materialId",
          "type",
          "qty"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "materialId": {
            "type": "string"
          },
          "type": {
            "enum": [
              "entrada",
              "salida"
            ]
          },
          "qty": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "orderId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "productionOrders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "productId",
          "specId",
          "status",
          "requests",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "productId": {
            "type": "string"
          },
          "specId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "completed"
            ]
          },
          "requests": {
            "type": "array"
          },
          "result": {
            "type": "object"
          },
          "snapshot": {
            "type": "object"
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "invoices": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "payments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "movements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "supplies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "supplyMovements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "packagingLinks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expenses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}